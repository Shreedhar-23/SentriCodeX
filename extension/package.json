{
  "name": "sentricodex",
  "displayName": "SentriCodeX",
  "description": "Local-first static security analysis for VS Code. Scan your code, find vulnerabilities, and get fix recommendations — without your source ever leaving your machine.",
  "version": "1.0.0",
  "publisher": "sentricodex",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#141e30",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sentricodex/sentricodex.git"
  },
  "bugs": {
    "url": "https://github.com/sentricodex/sentricodex/issues"
  },
  "homepage": "https://github.com/sentricodex/sentricodex#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "static analysis",
    "vulnerability scanner",
    "sast",
    "code quality",
    "secrets detection",
    "sql injection",
    "xss",
    "security linter",
    "owasp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sentricodex",
          "title": "SentriCodeX",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "sentricodex": [
        {
          "type": "webview",
          "id": "sentricodex.sidebar",
          "name": "SentriCodeX"
        }
      ]
    },
    "commands": [
      {
        "command": "sentricodex.scanCurrentFile",
        "title": "SentriCodeX: Scan Current File",
        "category": "SentriCodeX"
      },
      {
        "command": "sentricodex.scanWorkspace",
        "title": "SentriCodeX: Scan Workspace",
        "category": "SentriCodeX"
      },
      {
        "command": "sentricodex.generateReport",
        "title": "SentriCodeX: Generate Report",
        "category": "SentriCodeX"
      },
      {
        "command": "sentricodex.viewHistory",
        "title": "SentriCodeX: View Scan History",
        "category": "SentriCodeX"
      },
      {
        "command": "sentricodex.openSettings",
        "title": "SentriCodeX: Open Settings",
        "category": "SentriCodeX"
      },
      {
        "command": "sentricodex.showDashboard",
        "title": "SentriCodeX: Show Dashboard",
        "category": "SentriCodeX"
      }
    ],
    "configuration": {
      "title": "SentriCodeX",
      "properties": {
        "sentricodex.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Command or path used to invoke Python when running scans (e.g. 'python', 'python3', or an absolute path)."
        },
        "sentricodex.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically rescan a file when it is saved. (Save-trigger wiring arrives in a later phase.)"
        },
        "sentricodex.excludedFolders": {
          "type": "array",
          "default": [
            "node_modules",
            ".git",
            "dist",
            "out"
          ],
          "description": "Folders excluded from workspace scans."
        },
        "sentricodex.defaultReportFormat": {
          "type": "string",
          "enum": ["html", "json", "markdown"],
          "default": "html",
          "description": "Pre-selected format when generating a report."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle:engine",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "bundle:engine": "node scripts/bundle-engine.js",
    "package": "vsce package",
    "pretest:unit": "tsc -p tsconfig.test.json",
    "test:unit": "node --test out-test/test/unit/*.test.js",
    "pretest:integration": "tsc -p tsconfig.test.json",
    "test:integration": "node ./out-test/test/runTest.js",
    "test": "npm run test:unit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "eslint": "^8.56.0",
    "mocha": "^10.3.0",
    "typescript": "^5.3.3"
  }
}
